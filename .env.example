# Application
NODE_ENV=development
PORT=3001

# PostgreSQL
DATABASE_URL=

# Authentication
# Use independent, high-entropy secrets with at least 32 characters.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Browser CORS
# Optional in development/test. Required in staging/production.
# Comma-separated exact origins; do not include paths.
# Example: https://morada.ie,https://app.morada.ie
CORS_ORIGINS=
