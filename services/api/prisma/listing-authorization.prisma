enum ListingAuthorizationStatus {
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
}

enum ListingAuthorizationEvidenceType {
  TENANCY_AGREEMENT
  LANDLORD_AUTHORIZATION
  PROOF_OF_OWNERSHIP
  AGENCY_MANDATE
  OTHER_SUPPORTING_DOCUMENT
}

model ListingAuthorizationSubmission {
  id        String                     @id @default(cuid())
  listingId String
  status    ListingAuthorizationStatus @default(SUBMITTED)

  submittedAt  DateTime @default(now())
  reviewedAt   DateTime?
  reviewedBy   String?
  reviewReason String?

  relationshipVerified          Boolean?
  landlordAuthorizationVerified Boolean?

  retainUntil DateTime?
  deletedAt   DateTime?

  listing  Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  reviewer User?   @relation("ListingAuthorizationReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  evidence ListingAuthorizationEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId, submittedAt])
  @@index([status])
  @@index([reviewedBy])
  @@index([retainUntil])
  @@index([deletedAt])
}

model ListingAuthorizationEvidence {
  id               String                           @id @default(cuid())
  submissionId     String
  type             ListingAuthorizationEvidenceType
  objectKey        String                           @unique
  mimeType         String
  sizeBytes        Int
  sha256           String?
  originalFileName String?
  deletedAt        DateTime?

  submission ListingAuthorizationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([submissionId])
  @@index([type])
  @@index([deletedAt])
}
