generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  USER
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum LocationStatus {
  IN_IRELAND
  NOT_ARRIVED_YET
  ARRIVING_SOON
}

enum TrustLevel {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

enum IdentityDocumentType {
  PASSPORT
  EU_EEA_NATIONAL_ID
  DRIVING_LICENCE
  IRP
}

enum IdentityVerificationStatus {
  SUBMITTED
  UNDER_REVIEW
  CORRECTION_REQUIRED
  APPROVED
  REJECTED
  CANCELLED
}

enum IdentityEvidenceType {
  DOCUMENT_FRONT
  DOCUMENT_BACK
  SELFIE_WITH_DOCUMENT
}

enum ListingType {
  RENTAL
  TRANSFER
  EXCHANGE
  WANTED
}

enum ListingStatus {
  DRAFT
  PENDING_REVIEW
  ACTIVE
  PAUSED
  CLOSED
  REJECTED
}

enum PropertyType {
  SINGLE_ROOM
  SHARED_ROOM
  STUDIO
  APARTMENT
  HOUSE
  BED_SPACE
  OTHER
}

enum PropertyOccupancyType {
  ENTIRE_PROPERTY
  SHARED_PROPERTY
}

enum AdvertisedSpaceType {
  PRIVATE
  SHARED
}

enum RoomType {
  SINGLE
  DOUBLE
  TWIN
  ENSUITE
  STUDIO
  OTHER
}

enum BedType {
  SINGLE
  DOUBLE
  BUNK
  TWO_SINGLE_BEDS
  OTHER
}

enum BathroomType {
  PRIVATE
  SHARED
}

enum HouseholdGenderComposition {
  ALL_WOMEN
  ALL_MEN
  MIXED
  OTHER
  NOT_STATED
}

enum HeatingType {
  CENTRAL
  GAS
  ELECTRIC
  HEAT_PUMP
  OTHER
  NOT_STATED
}

enum KitchenAmenity {
  FRIDGE
  FREEZER
  OVEN
  HOB
  MICROWAVE
  DISHWASHER
  KETTLE
}

enum OutdoorAmenity {
  BALCONY
  GARDEN
  YARD
  TERRACE
  SHARED_OUTDOOR_SPACE
}

enum TransportMode {
  BUS
  LUAS
  DART
  TRAIN
}

enum BillsIncludedType {
  YES
  NO
  PARTIAL
}

enum GenderPreference {
  FEMALE_ONLY
  MALE_ONLY
  ANY
}

enum ConversationStatus {
  ACTIVE
  BLOCKED
}

enum MessageType {
  TEXT
  IMAGE
}

enum ReportStatus {
  OPEN
  UNDER_REVIEW
  RESOLVED
  DISMISSED
}

enum ReportReason {
  SCAM
  HARASSMENT
  SPAM
  OFFENSIVE_LANGUAGE
  MISLEADING_LISTING
  SUSPICIOUS_PAYMENT
  ABUSIVE_BEHAVIOR
  OTHER
}

enum NotificationType {
  NEW_MESSAGE
  LISTING_APPROVED
  LISTING_REJECTED
  LISTING_PAUSED
  ACCOUNT_SUSPENDED
  ACCOUNT_BANNED
  PHONE_VERIFIED
}

model User {
  id               String     @id @default(cuid())
  email            String     @unique
  passwordHash     String?
  refreshTokenHash String?
  role             UserRole   @default(USER)
  status           UserStatus @default(ACTIVE)
  emailVerified    Boolean    @default(false)
  phoneVerified    Boolean    @default(false)
  lastLoginAt      DateTime?

  profile      UserProfile?
  verification Verification?
  trustScore   TrustScore?

  listings  Listing[]
  favorites Favorite[]

  conversationsAsA Conversation[] @relation("ParticipantA")
  conversationsAsB Conversation[] @relation("ParticipantB")
  messages         Message[]

  reportsMade     Report[] @relation("Reporter")
  reportsReceived Report[] @relation("ReportedUser")

  blocksCreated  Block[] @relation("Blocker")
  blocksReceived Block[] @relation("Blocked")

  notifications Notification[]
  adminActions  AdminActionLog[] @relation("AdminActions")

  identityReviews IdentityVerificationSubmission[] @relation("IdentityReviewer")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status])
  @@index([role])
}

model UserProfile {
  id                    String         @id @default(cuid())
  userId                String         @unique
  displayName           String
  fullName              String?
  dateOfBirth           DateTime?
  nationality           String?
  hometown              String?
  phone                 String?
  profilePhotoUrl       String?
  profilePhotoPublicId  String?
  bio                   String?
  primaryLanguage       String?
  currentLocationStatus LocationStatus @default(IN_IRELAND)
  currentCity           String?
  arrivalDate           DateTime?
  occupation            String?
  isStudent             Boolean        @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Verification {
  id                        String    @id @default(cuid())
  userId                    String    @unique
  emailVerifiedAt           DateTime?
  phoneVerifiedAt           DateTime?
  phoneVerificationProvider String?

  documentStatus      String?
  documentSubmittedAt DateTime?
  documentReviewedAt  DateTime?

  user                User                             @relation(fields: [userId], references: [id], onDelete: Cascade)
  identitySubmissions IdentityVerificationSubmission[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IdentityVerificationSubmission {
  id             String                     @id @default(cuid())
  verificationId String
  documentType   IdentityDocumentType
  status         IdentityVerificationStatus @default(SUBMITTED)

  submittedAt DateTime @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
  reviewReason String?

  retainUntil DateTime?
  deletedAt   DateTime?

  verification Verification @relation(fields: [verificationId], references: [id], onDelete: Cascade)
  reviewer     User?        @relation("IdentityReviewer", fields: [reviewedBy], references: [id], onDelete: SetNull)
  evidence     IdentityVerificationEvidence[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationId, submittedAt])
  @@index([status])
  @@index([reviewedBy])
  @@index([retainUntil])
  @@index([deletedAt])
}

model IdentityVerificationEvidence {
  id           String               @id @default(cuid())
  submissionId String
  type         IdentityEvidenceType
  objectKey    String               @unique
  mimeType     String
  sizeBytes    Int
  sha256       String?

  deletedAt DateTime?

  submission IdentityVerificationSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([submissionId, type])
  @@index([submissionId])
  @@index([deletedAt])
}

model TrustScore {
  id               String     @id @default(cuid())
  userId           String     @unique
  score            Int        @default(0)
  level            TrustLevel @default(LOW)
  lastCalculatedAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Listing {
  id     String        @id @default(cuid())
  userId String
  type   ListingType
  status ListingStatus @default(PENDING_REVIEW)

  title       String
  description String

  city           String?
  area           String?
  county         String?
  postalDistrict String?
  propertyType   PropertyType?

  propertyOccupancyType       PropertyOccupancyType?
  advertisedSpaceType         AdvertisedSpaceType?
  bedroomCount                Int?
  bathroomCount               Int?
  roomType                    RoomType?
  bedType                     BedType?
  maxOccupants                Int?
  peopleSharingSpace          Int?
  bathroomType                BathroomType?
  peopleSharingBathroom       Int?
  currentResidentCount        Int?
  householdGenderComposition  HouseholdGenderComposition?

  monthlyPriceCents          Int?
  depositAmountCents         Int?
  billsIncludedType          BillsIncludedType?
  estimatedMonthlyBillsCents Int?
  firstRentAdvanceCents      Int?
  extraCostsNote             String?

  furnished               Boolean?
  couplesAllowed          Boolean?
  petsAllowed             Boolean?
  smokingAllowed          Boolean?
  genderPreference        GenderPreference?
  landlordLivesHere       Boolean?
  childrenFamiliesAllowed Boolean?
  studentsAllowed         Boolean?

  formalContract              Boolean?
  landlordApprovalRequired    Boolean?
  proofOfIncomeRequired       Boolean?
  proofOfEmploymentRequired   Boolean?
  priorReferenceRequired      Boolean?
  otherRequirementsNote       String?

  availableFrom   DateTime?
  availableUntil  DateTime?
  minimumStayDays Int?

  floorNumber             Int?
  isGroundFloor           Boolean?
  hasLift                 Boolean?
  stepFreeAccess          Boolean?
  accessibleEntrance      Boolean?
  adaptedBathroom         Boolean?
  wheelchairSpace         Boolean?
  accessibleParking       Boolean?
  accessibilityOtherNote  String?

  heatingType             HeatingType?
  internetAvailable       Boolean?
  wifiAvailable           Boolean?
  internetIncludedInBills Boolean?
  internetSpeedMbps       Int?
  internetProvider        String?

  washingMachine        Boolean?
  dryer                 Boolean?
  laundrySharedBuilding Boolean?
  laundryExtraCost      Boolean?

  kitchenAmenities KitchenAmenity[] @default([])
  outdoorAmenities OutdoorAmenity[] @default([])

  carParkingAvailable       Boolean?
  motorbikeParkingAvailable Boolean?
  bicycleParkingAvailable   Boolean?
  parkingPaid               Boolean?
  parkingSecure             Boolean?

  partiesAllowed  Boolean?
  visitorsAllowed Boolean?
  quietHoursNote  String?
  houseRules      String?
  transportInfo   String?

  trustScore      Int     @default(0)
  rejectionReason String?
  pausedReason    String?

  publishedAt DateTime?
  closedAt    DateTime?
  deletedAt   DateTime?

  user               User                     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos             ListingPhoto[]
  exchangePreference ExchangePreference?
  transportOptions   ListingTransportOption[]
  privateLocation    ListingPrivateLocation?
  publicLocation     ListingPublicLocation?
  favorites          Favorite[]
  conversations      Conversation[]
  reports            Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([status])
  @@index([type])
  @@index([city])
  @@index([area])
  @@index([county])
  @@index([postalDistrict])
  @@index([monthlyPriceCents])
  @@index([availableFrom])
  @@index([propertyOccupancyType])
  @@index([advertisedSpaceType])
  @@index([bedroomCount])
  @@index([bathroomCount])
  @@index([minimumStayDays])
  @@index([createdAt])
  @@index([deletedAt])
}

model ListingPrivateLocation {
  id             String  @id @default(cuid())
  listingId      String  @unique
  addressLine1   String
  addressLine2   String?
  eircode        String?
  exactLatitude  Float
  exactLongitude Float

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ListingPublicLocation {
  id                   String @id @default(cuid())
  listingId            String @unique
  latitude             Float
  longitude            Float
  radiusMeters         Int
  approximationVersion String

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([latitude])
  @@index([longitude])
}

model ListingTransportOption {
  id             String        @id @default(cuid())
  listingId      String
  mode           TransportMode
  stopName       String?
  lineName       String?
  walkingMinutes Int?
  distanceMeters Int?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([listingId])
  @@index([mode])
  @@index([listingId, mode])
}

model ExchangePreference {
  id        String @id @default(cuid())
  listingId String @unique

  desiredCity          String?
  desiredAreas         String[]
  desiredMinPriceCents Int?
  desiredMaxPriceCents Int?
  desiredPropertyTypes PropertyType[]
  desiredMoveDate      DateTime?
  notes                String?

  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Favorite {
  id        String @id @default(cuid())
  userId    String
  listingId String

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  listing Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([userId, listingId])
  @@index([userId])
  @@index([listingId])
}

model Conversation {
  id             String             @id @default(cuid())
  listingId      String
  participantAId String
  participantBId String
  status         ConversationStatus @default(ACTIVE)
  lastMessageAt  DateTime?

  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)
  participantA User    @relation("ParticipantA", fields: [participantAId], references: [id], onDelete: Cascade)
  participantB User    @relation("ParticipantB", fields: [participantBId], references: [id], onDelete: Cascade)

  messages Message[]
  reports  Report[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, participantAId, participantBId])
  @@index([listingId])
  @@index([participantAId])
  @@index([participantBId])
  @@index([lastMessageAt])
}

model Message {
  id             String      @id @default(cuid())
  conversationId String
  senderId       String
  type           MessageType @default(TEXT)
  body           String?
  imageUrl       String?
  imagePublicId  String?
  readAt         DateTime?

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
}

model Report {
  id             String       @id @default(cuid())
  reporterId     String
  reportedUserId String?
  listingId      String?
  conversationId String?
  reason         ReportReason
  description    String?
  status         ReportStatus @default(OPEN)
  adminNotes     String?
  resolvedAt     DateTime?

  reporter     User          @relation("Reporter", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedUser User?         @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: SetNull)
  listing      Listing?      @relation(fields: [listingId], references: [id], onDelete: SetNull)
  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([reporterId])
  @@index([reportedUserId])
  @@index([listingId])
  @@index([conversationId])
  @@index([status])
  @@index([createdAt])
}

model Block {
  id        String @id @default(cuid())
  blockerId String
  blockedId String

  blocker User @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
}

model Notification {
  id         String           @id @default(cuid())
  userId     String
  type       NotificationType
  title      String
  body       String
  isRead     Boolean          @default(false)
  targetType String?
  targetId   String?
  metadata   Json?
  readAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
}

model AdminActionLog {
  id         String  @id @default(cuid())
  adminId    String
  action     String
  targetType String
  targetId   String
  reason     String?
  metadata   Json?

  admin User @relation("AdminActions", fields: [adminId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@index([adminId])
  @@index([action])
  @@index([targetType, targetId])
  @@index([createdAt])
}

model ListingPhoto {
  id        String  @id @default(cuid())
  listingId String
  listing   Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  objectKey String @unique
  url       String
  position  Int

  width     Int
  height    Int
  sizeBytes Int
  mimeType  String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([listingId, position])
  @@index([listingId, position])
}
