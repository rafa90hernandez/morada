{
  "expo": {
    "name": "Morada",
    "slug": "morada",
    "version": "0.2.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "morada",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "plugins": ["expo-router"],
    "splash": {
      "image": "./assets/adaptive-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#F8F7EF"
    },
    "experiments": {
      "typedRoutes": true
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "ie.morada.mobile"
    },
    "android": {
      "package": "ie.morada.mobile",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#004D3F"
      }
    },
    "web": {
      "bundler": "metro",
      "backgroundColor": "#F8F7EF"
    }
  }
}
