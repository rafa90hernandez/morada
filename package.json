{
  "name": "morada",
  "version": "1.0.0",
  "description": "Morada monorepo",
  "private": true,
  "scripts": {
    "dev:mobile": "pnpm --filter @morada/mobile start",
    "typecheck:mobile": "pnpm --filter @morada/mobile typecheck",
    "generate": "turbo run generate",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "build": "turbo run build",
    "backup:validate": "bash scripts/backup/validate-backup-scripts.sh",
    "quality": "pnpm generate && pnpm lint && pnpm typecheck && pnpm test && pnpm backup:validate && pnpm build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^11.10.0",
      "onFail": "download"
    }
  },
  "type": "module",
  "devDependencies": {
    "@types/node": "^26.1.0",
    "eslint": "^10.6.0",
    "prettier": "^3.9.4",
    "tsx": "^4.23.0",
    "turbo": "^2.10.3",
    "typescript": "^6.0.3"
  }
}
